# Applicant documents (birth certificates, report cards, IDs) are private.
# They are served only through the authenticated document viewer routes, never directly.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
